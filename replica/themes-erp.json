{
  "_about": "Themes for replica-entrepreneur, tuned for Odoo/ERP feedback (not the default consumer-app themes.json). Patterns are Python regular expressions, matched case-insensitively.",
  "request_patterns": [
    "\\bi wish\\b",
    "\\bplease add\\b",
    "\\bwould be (nice|great|good|helpful)\\b",
    "\\bwould love\\b",
    "\\bneeds? (a|an|the|to|more)\\b",
    "\\bno way to\\b",
    "\\bthere'?s no (way|option)\\b",
    "\\b(can'?t|cannot|unable to) (even )?(add|change|edit|set|choose|export|import|customi[sz]e|connect|undo|delete|turn off)\\b",
    "\\b(missing|lacks|lacking)\\b",
    "\\bdoesn'?t (have|support|let|allow)\\b",
    "\\bif only\\b",
    "\\bfeature request\\b",
    "\\bwhy (can'?t|isn'?t|doesn'?t)\\b",
    "\\bit would be great if\\b",
    "\\bmajor downfall\\b"
  ],
  "themes": [
    {"id": "pricing", "label": "Pricing: per-app, per-user, creeps up", "kind": "complaint",
     "patterns": ["\\bcharged a premium\\b", "\\bper (month|seat|user)\\b", "\\bsubscription costs?\\b", "\\bsubscription\\b", "\\bexpensive\\b", "\\boverpriced\\b", "\\bupgrade to\\b", "\\bpric(e|es|ing)\\b", "\\bstack applications\\b", "\\bfee went from\\b", "\\bmore than doubled\\b", "\\bpremium\\b"]},
    {"id": "billing_surprise", "label": "Billing surprises and price changes without warning", "kind": "complaint",
     "patterns": ["\\bcharge us double\\b", "\\bdoubled our\\b", "\\bprice hike\\b", "\\bhidden (fee|charge)", "\\bdon'?t honou?r\\b", "\\bterms of service\\b", "\\brefund", "\\bmother of all invoices\\b", "\\bcross.?country pricing\\b"]},
    {"id": "support", "label": "Support that is slow, absent, or outsourced to paid consultants", "kind": "complaint",
     "patterns": ["\\bcustomer (service|support)\\b", "\\bsupport (team|is|was)\\b", "\\bno (response|reply)\\b", "\\bnever (replied|responded|heard back)\\b", "\\bnonexistent\\b", "\\bconsult(ant|ing)\\b", "\\b3rd party\\b", "\\bthird.?party\\b", "\\bvague\\b", "\\bunhelpful\\b"]},
    {"id": "implementation", "label": "Implementation needs coding or a paid consultant", "kind": "complaint",
     "patterns": ["\\bimplementation\\b", "\\brequires? coding\\b", "\\bneeds? (a |an )?coding\\b", "\\btechnical (knowledge|skills|background)\\b", "\\bclunky\\b", "\\bover budget\\b", "\\bonboarding\\b", "\\bon-boarding\\b", "\\bsetup\\b"]},
    {"id": "docs", "label": "Thin or outdated documentation", "kind": "complaint",
     "patterns": ["\\bdocumentation\\b", "\\bpoorly documented\\b", "\\bself.?serv(ice|ice)\\b", "\\bhalf ass\\b", "\\bself help\\b"]},
    {"id": "learning_curve", "label": "Steep learning curve, too many modules/menus", "kind": "complaint",
     "patterns": ["\\blearning curve\\b", "\\bcomplicated\\b", "\\bconfus", "\\bdaunting\\b", "\\boverwhelming\\b", "\\bso many modules\\b", "\\bmenus? and configuration\\b", "\\bmany modules, menus\\b"]},
    {"id": "ux_generic", "label": "Generic / cookie-cutter / inconsistent UI across apps", "kind": "complaint",
     "patterns": ["\\bcookie cutter\\b", "\\bCRUD implementation\\b", "\\beach application looks somewhat different\\b", "\\bbuttons move around\\b", "\\bpress the wrong corner\\b", "\\binconsisten", "\\bnot intuitive\\b", "\\bunintuitive\\b"]},
    {"id": "performance", "label": "Slow with large data, spinners, sync issues", "kind": "complaint",
     "patterns": ["\\bslow\\b", "\\bspinning\\b", "\\bspinner\\b", "\\bsync(hronization|ing)?\\b", "\\blag(gy|s)?\\b", "\\bloading\\b", "\\btakes forever\\b", "\\bglitch(y)?\\b", "\\bbugs?\\b", "\\bbroken\\b"]},
    {"id": "data_integrity", "label": "Data integrity: wrong inventory counts, numbering gaps, duplicates", "kind": "complaint",
     "patterns": ["\\bnot discounted\\b", "\\bjumps? in the correlativ", "\\bduplicate (customer|contact)", "\\bdata (loss|wasn'?t flowing)\\b", "\\bwrong amount\\b", "\\bdiscrepanc"]},
    {"id": "customization_limits", "label": "Customization hits a wall without a developer", "kind": "complaint",
     "patterns": ["\\brequires? coding\\b", "\\bcustom(i[sz]ation|i[sz]e)\\b", "\\bblocks you from changing\\b", "\\bstudio\\b", "\\breverse.?engineer\\b", "\\bcore coding\\b"]},
    {"id": "sales_tactics", "label": "Sales oversold it / referral-driven recommendations", "kind": "complaint",
     "patterns": ["\\bsalesman\\b", "\\boversold\\b", "\\breferral fee\\b", "\\bsales executive\\b", "\\bwill say anything\\b"]},
    {"id": "everything_app", "label": "Tries to do everything, so each module is shallow", "kind": "complaint",
     "patterns": ["\\btries to be everything\\b", "\\bdo everything\\b", "\\bfalls short\\b", "\\bgaps\\b", "\\bmissing a lot of functionality\\b"]},
    {"id": "open_core", "label": "\"Open source\" gates real features behind Enterprise", "kind": "complaint",
     "patterns": ["\\bopen source.{0,20}until\\b", "\\benterprise\\b.{0,30}things", "\\bopen.?core\\b", "\\bfree.{0,10}(plan|tier|version|app)\\b.{0,40}upgrade"]},
    {"id": "export_integrations", "label": "Integrations and import/export are hit or miss", "kind": "request",
     "patterns": ["\\bintegrat", "\\bwhatsapp\\b", "\\bgmail\\b", "\\bapi\\b", "\\bexport\\b", "\\bimport\\b", "\\bcsv\\b", "\\bmarketplace modules?\\b"]},
    {"id": "multicurrency", "label": "Multi-currency / multi-country setup is confusing", "kind": "request",
     "patterns": ["\\bmultiple currenc", "\\bcross.?country\\b", "\\bdifferent countr(y|ies)\\b", "\\bshipping tax rates?\\b", "\\bcurrenc(y|ies)\\b"]},
    {"id": "reporting", "label": "Custom reports and dashboards are frustrating to build", "kind": "request",
     "patterns": ["\\bcustom reports?\\b", "\\breport generation\\b", "\\bdashboard\\b", "\\bpivot\\b"]}
  ]
}
