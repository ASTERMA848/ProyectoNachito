# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Plantilla de variables de entorno
# Copiar este archivo como ".env" y completar con valores reales.
# NUNCA incluir valores reales en este archivo.
# ─────────────────────────────────────────────────────────────────────────────

# Base de datos
# PostgreSQL local con Docker Compose
DATABASE_URL="postgresql://admin:admin_password@127.0.0.1:5434/agencia_cambio?schema=public"

# Requerida solo para inicializar el primer administrador
INITIAL_ADMIN_PASSWORD=""

# Habilitar solo detrás de un proxy que sobrescriba X-Real-IP
TRUST_PROXY="false"

# Opcional. Conexión exclusiva del rol calce_report_reader (ver prisma/reporting.sql)
SQL_REPORTING_DATABASE_URL=""
