# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Plantilla de variables de entorno
# Copiar este archivo como ".env" y completar con valores reales.
# NUNCA incluir valores reales en este archivo.
# ─────────────────────────────────────────────────────────────────────────────

# Base de datos
# SQLite (desarrollo): file:./dev.db
# PostgreSQL (producción): postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL="file:./dev.db"

# Secreto para la sesión (generar con: openssl rand -hex 32)
SESSION_SECRET="CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_64_CARACTERES"

# Entorno de ejecución
NODE_ENV="development"

# Tamaño máximo de archivos subidos en MB (por defecto: 5)
MAX_UPLOAD_MB="5"
